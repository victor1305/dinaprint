# Credenciales del formulario de contacto (app/api/contacto).
# Son variables de SERVIDOR: sin prefijo NEXT_PUBLIC_, nunca llegan al navegador.
# En Coolify se declaran como variables normales de runtime, NO como build args.
#
# Copia este fichero a `.env` para desarrollo local. `.env` está en .gitignore.

# SMTP_USER es la cuenta que AUTENTICA. Con Google Workspace tiene que ser la
# cuenta real, nunca un alias, y SMTP_PASSWORD una contraseña de aplicación.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=dinaprint@dinaprint.com
SMTP_PASSWORD=bugy joxs wodi jqpv

# Buzón que recibe los avisos. Por defecto, SMTP_USER.
CONTACT_TO=dinaprint@dinaprint.com

# Dirección que ve el destinatario, que puede ser un alias distinto de la cuenta
# que autentica. Debe ser del dominio propio: con la del visitante, SPF y DKIM
# no cuadrarían y el aviso acabaría en spam.
#
# OJO con los alias: Gmail reescribe la cabecera From y la sustituye por la
# cuenta autenticada salvo que el alias esté dado de alta en Gmail, en
# Configuración > Cuentas > "Enviar mensaje como". Sin ese paso el alias se
# ignora sin dar ningún error y los correos salen desde SMTP_USER.
CONTACT_FROM=web@dinaprint.com

# Opcional. Clave para firmar el reto anti-robots del formulario. Si se deja
# vacía se genera una por proceso, que basta con una sola réplica: la única pega
# es que un reinicio invalida los retos ya servidos. Con varias réplicas hay que
# fijarla, porque si no cada una firmaría con una clave distinta.
CONTACT_SECRET=
